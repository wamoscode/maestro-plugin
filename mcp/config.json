{
  "name": "maestro-mcp",
  "version": "1.10.1",
  "description": "MCP server for Maestro plugin - provides advanced orchestration and multi-branch session capabilities",
  "server": {
    "type": "stdio",
    "command": "node",
    "args": ["server.js"]
  },
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": true
  },
  "tools": [
    {
      "name": "list_agents",
      "description": "List all available sub-agents with their descriptions and capabilities",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Filter by category (e.g., 'core-development', 'infrastructure')"
          },
          "search": {
            "type": "string",
            "description": "Search agents by name or description"
          }
        }
      }
    },
    {
      "name": "get_agent_info",
      "description": "Get detailed information about a specific sub-agent",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "description": "The agent ID (e.g., 'backend-developer')"
          }
        },
        "required": ["agentId"]
      }
    },
    {
      "name": "analyze_task",
      "description": "Analyze a task and recommend appropriate sub-agents",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "The task description to analyze"
          }
        },
        "required": ["task"]
      }
    },
    {
      "name": "execute_workflow",
      "description": "Execute a defined workflow with multiple sub-agents",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow": {
            "type": "string",
            "description": "Workflow definition in YAML or JSON format"
          },
          "variables": {
            "type": "object",
            "description": "Variables to pass to the workflow"
          }
        },
        "required": ["workflow"]
      }
    },
    {
      "name": "get_execution_status",
      "description": "Get the status of a running or completed execution",
      "inputSchema": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "description": "The execution ID to query"
          }
        },
        "required": ["executionId"]
      }
    },
    {
      "name": "get_metrics",
      "description": "Get execution metrics and statistics",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "description": "Filter metrics by agent (optional)"
          },
          "timeRange": {
            "type": "string",
            "description": "Time range: 'hour', 'day', 'week', 'month' (optional)"
          }
        }
      }
    },
    {
      "name": "sync_status",
      "description": "Get synchronization status for all configured platforms",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Filter by platform (optional)"
          }
        }
      }
    },
    {
      "name": "sync_push",
      "description": "Push CDD tracks to external platforms",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Target platform (clickup, linear, jira, asana, todoist, youtrack, notion, github)"
          },
          "trackId": {
            "type": "string",
            "description": "Specific track ID to push (optional, pushes all if omitted)"
          },
          "force": {
            "type": "boolean",
            "description": "Force push even with conflicts"
          },
          "dryRun": {
            "type": "boolean",
            "description": "Preview changes without applying"
          }
        }
      }
    },
    {
      "name": "sync_pull",
      "description": "Pull items from external platforms to CDD",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Source platform to pull from"
          },
          "force": {
            "type": "boolean",
            "description": "Force pull even with conflicts"
          },
          "dryRun": {
            "type": "boolean",
            "description": "Preview changes without applying"
          }
        }
      }
    },
    {
      "name": "sync_link",
      "description": "Link a CDD track to an external platform item",
      "inputSchema": {
        "type": "object",
        "properties": {
          "trackId": {
            "type": "string",
            "description": "The CDD track ID"
          },
          "platform": {
            "type": "string",
            "description": "The external platform"
          },
          "externalId": {
            "type": "string",
            "description": "The external item ID"
          }
        },
        "required": ["trackId", "platform", "externalId"]
      }
    },
    {
      "name": "sync_test",
      "description": "Test connection to external platforms",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Platform to test (optional, tests all if omitted)"
          }
        }
      }
    },
    {
      "name": "sync_config",
      "description": "Get or update sync configuration",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["get", "init", "validate"],
            "description": "Action to perform"
          },
          "platform": {
            "type": "string",
            "description": "Platform to configure (optional)"
          }
        }
      }
    },
    {
      "name": "complete_execution",
      "description": "Complete a workflow execution and run post-execution hooks",
      "inputSchema": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "description": "The execution ID to complete"
          },
          "results": {
            "type": "object",
            "description": "Execution results (success, outputs, errors)"
          }
        },
        "required": ["executionId"]
      }
    },
    {
      "name": "learning_init",
      "description": "Initialize a learning session for the Context-Aware Learning System",
      "inputSchema": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string",
            "description": "Git branch name for the learning session"
          },
          "sessionId": {
            "type": "string",
            "description": "Session identifier (auto-generated if not provided)"
          },
          "options": {
            "type": "object",
            "description": "Initialization options (trackId, etc.)"
          }
        },
        "required": ["branch"]
      }
    },
    {
      "name": "learning_finalize",
      "description": "Finalize the current learning session and persist all learnings",
      "inputSchema": {
        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "description": "Finalization options (generateRetrospective, etc.)"
          }
        }
      }
    },
    {
      "name": "learning_status",
      "description": "Get the current learning session status and summary",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "learning_capture",
      "description": "Capture a decision, research finding, or discovery",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["decision", "research", "discovery"],
            "description": "Type of learning to capture"
          },
          "data": {
            "type": "object",
            "description": "Learning data (title, description, rationale, context, etc.)"
          }
        },
        "required": ["type", "data"]
      }
    },
    {
      "name": "learning_get_knowledge",
      "description": "Get relevant knowledge for a task context",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskContext": {
            "type": "object",
            "description": "Task context (description, domain, tags, etc.)"
          }
        }
      }
    },
    {
      "name": "learning_phase_complete",
      "description": "Handle phase completion and summarize phase learnings",
      "inputSchema": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "object",
            "description": "Phase information (name, id, tasks completed)"
          },
          "track": {
            "type": "object",
            "description": "Track data"
          }
        },
        "required": ["phase"]
      }
    }
  ],
  "resources": [
    {
      "uri": "maestro://agents",
      "name": "Agent Registry",
      "description": "The complete registry of available sub-agents",
      "mimeType": "application/json"
    },
    {
      "uri": "maestro://workflows",
      "name": "Saved Workflows",
      "description": "User-defined workflow templates",
      "mimeType": "application/json"
    },
    {
      "uri": "maestro://logs/{executionId}",
      "name": "Execution Logs",
      "description": "Logs for a specific execution",
      "mimeType": "application/json"
    },
    {
      "uri": "maestro://sync/config",
      "name": "Sync Configuration",
      "description": "Platform synchronization configuration",
      "mimeType": "application/json"
    },
    {
      "uri": "maestro://sync/status",
      "name": "Sync Status",
      "description": "Current synchronization status for all platforms",
      "mimeType": "application/json"
    },
    {
      "uri": "maestro://sync/links",
      "name": "Sync Links",
      "description": "Mappings between CDD tracks and external platform items",
      "mimeType": "application/json"
    },
    {
      "uri": "maestro://learning/status",
      "name": "Learning Status",
      "description": "Current learning session status and summary",
      "mimeType": "application/json"
    },
    {
      "uri": "maestro://learning/knowledge",
      "name": "Knowledge Store",
      "description": "Accumulated knowledge from the learning system",
      "mimeType": "application/json"
    }
  ],
  "prompts": [
    {
      "name": "orchestrate",
      "description": "Orchestrate a complex task with Maestro",
      "arguments": [
        {
          "name": "task",
          "description": "The task to orchestrate",
          "required": true
        }
      ]
    },
    {
      "name": "create_workflow",
      "description": "Create a new workflow from a task description",
      "arguments": [
        {
          "name": "description",
          "description": "Description of the workflow to create",
          "required": true
        }
      ]
    }
  ],
  "settings": {
    "maxConcurrentExecutions": 5,
    "defaultTimeout": 300000,
    "enableLogging": true,
    "logLevel": "info"
  }
}
