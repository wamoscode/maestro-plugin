{
  "name": "maestro",
  "version": "1.3.0",
  "description": "Master orchestrator plugin with Context-Driven Development methodology, multi-project workspaces, git submodule support, and 100+ specialized sub-agents for intelligent task routing",
  "author": {
    "name": "Maestro Team",
    "url": "https://github.com/maestro-plugin"
  },
  "license": "MIT",
  "repository": "https://github.com/maestro-plugin/maestro",
  "homepage": "https://github.com/maestro-plugin/maestro#readme",
  "bugs": "https://github.com/maestro-plugin/maestro/issues",
  "keywords": [
    "claude-code",
    "plugin",
    "orchestrator",
    "multi-agent",
    "subagents",
    "automation",
    "maestro",
    "context-driven",
    "tdd",
    "workflow",
    "multi-project",
    "workspace",
    "git-submodules",
    "cross-project"
  ],
  "engines": {
    "claude-code": ">=1.0.0"
  },
  "commands": [
    "maestro",
    "maestro:setup",
    "maestro:newTrack",
    "maestro:status",
    "maestro:implement",
    "maestro:revert",
    "maestro:workspace",
    "maestro:projects",
    "workflow",
    "parallel-execute",
    "list-subagents",
    "agent-info"
  ],
  "features": {
    "contextDrivenDevelopment": true,
    "multiProjectWorkspaces": true,
    "gitSubmoduleSupport": true,
    "crossProjectTracks": true,
    "workflowTemplates": ["tdd", "agile", "minimal"],
    "subagentCount": 100
  }
}
