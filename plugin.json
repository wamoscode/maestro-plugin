{
  "name": "maestro",
  "version": "1.4.0",
  "description": "Master orchestrator plugin with Context-Driven Development methodology, multi-project workspaces, git submodule support, and 40+ specialized sub-agents for intelligent task routing",
  "main": "mcp/server.js",
  "author": {
    "name": "Maestro Team",
    "url": "https://github.com/wamoscode"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wamoscode/maestro-plugin.git"
  },
  "homepage": "https://github.com/wamoscode/maestro-plugin#readme",
  "bugs": {
    "url": "https://github.com/wamoscode/maestro-plugin/issues"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "orchestrator",
    "multi-agent",
    "subagents",
    "automation",
    "maestro",
    "context-driven",
    "cdd",
    "tdd",
    "workflow",
    "multi-project",
    "workspace",
    "git-submodules",
    "cross-project",
    "mcp"
  ],
  "engines": {
    "claude-code": ">=1.0.0"
  },
  "commands": [
    "maestro",
    "maestro:cdd",
    "maestro:setup",
    "maestro:newTrack",
    "maestro:status",
    "maestro:implement",
    "maestro:revert",
    "maestro:workspace",
    "maestro:projects",
    "workflow",
    "parallel-execute",
    "list-subagents",
    "agent-info"
  ],
  "features": {
    "contextDrivenDevelopment": true,
    "multiProjectWorkspaces": true,
    "gitSubmoduleSupport": true,
    "crossProjectTracks": true,
    "workflowTemplates": ["tdd", "agile", "minimal"],
    "subagentCount": 42
  },
  "directories": {
    "commands": "commands",
    "subagents": "subagents",
    "hooks": "hooks",
    "skills": "skills",
    "templates": "templates",
    "mcp": "mcp"
  }
}
