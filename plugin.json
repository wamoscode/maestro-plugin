{
  "name": "maestro",
  "version": "1.7.0",
  "description": "Master orchestrator plugin with Context-Driven Development methodology, multi-project workspaces, platform sync, git submodule support, 40+ specialized sub-agents, context versioning, quality gates, and intelligent project management",
  "main": "mcp/server.js",
  "author": {
    "name": "Maestro Team",
    "url": "https://github.com/wamoscode"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wamoscode/maestro-plugin.git"
  },
  "homepage": "https://github.com/wamoscode/maestro-plugin#readme",
  "bugs": {
    "url": "https://github.com/wamoscode/maestro-plugin/issues"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "orchestrator",
    "multi-agent",
    "subagents",
    "automation",
    "maestro",
    "context-driven",
    "cdd",
    "tdd",
    "workflow",
    "multi-project",
    "workspace",
    "git-submodules",
    "cross-project",
    "mcp",
    "platform-sync",
    "jira",
    "linear",
    "asana",
    "clickup",
    "todoist",
    "youtrack"
  ],
  "engines": {
    "claude-code": ">=1.0.0"
  },
  "commands": [
    "maestro",
    "maestro:cdd",
    "maestro:setup",
    "maestro:newTrack",
    "maestro:status",
    "maestro:implement",
    "maestro:revert",
    "maestro:workspace",
    "maestro:projects",
    "maestro:dashboard",
    "maestro:impact",
    "maestro:stash",
    "maestro:quick",
    "maestro:sync",
    "workflow",
    "parallel-execute",
    "list-subagents",
    "agent-info"
  ],
  "features": {
    "contextDrivenDevelopment": true,
    "contextVersioning": true,
    "multiProjectWorkspaces": true,
    "gitSubmoduleSupport": true,
    "crossProjectTracks": true,
    "crossProjectIntelligence": true,
    "trackHierarchy": true,
    "trackArchetypes": true,
    "customWorkflows": true,
    "qualityGates": true,
    "impactAnalysis": true,
    "agentPerformanceTracking": true,
    "knowledgeCapture": true,
    "trackStashing": true,
    "platformSync": true,
    "supportedPlatforms": ["clickup", "linear", "asana", "jira", "todoist", "youtrack", "notion", "github"],
    "mcpSync": true,
    "workflowTemplates": ["tdd", "agile", "minimal", "custom"],
    "subagentCount": 42
  },
  "directories": {
    "commands": "commands",
    "subagents": "subagents",
    "hooks": "hooks",
    "skills": "skills",
    "templates": "templates",
    "mcp": "mcp"
  }
}
