{
  "$schema": "https://claude.ai/schemas/plugin-manifest-v1.json",
  "id": "maestro",
  "name": "Maestro",
  "version": "1.0.0",
  "description": "Master orchestrator plugin with 100+ specialized sub-agents",
  "main": "../plugin.json",
  "type": "plugin",
  "enabled": true,
  "entryPoints": {
    "commands": "../commands",
    "subagents": "../subagents",
    "hooks": "../hooks",
    "skills": "../skills",
    "mcp": "../mcp"
  },
  "configuration": {
    "schema": "config-schema.json",
    "defaults": {
      "maxParallelAgents": 5,
      "defaultTimeout": 300000,
      "enableLogging": true,
      "logLevel": "info",
      "isolatedContexts": true,
      "autoRetry": true,
      "maxRetries": 3
    }
  },
  "hooks": {
    "preExecution": "../hooks/pre-execution.js",
    "postExecution": "../hooks/post-execution.js",
    "errorHandler": "../hooks/error-handler.js",
    "agentRouter": "../hooks/agent-router.js"
  },
  "activation": {
    "events": ["onStartup", "onCommand:maestro"]
  }
}
